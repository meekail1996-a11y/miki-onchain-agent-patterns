# Copy this file to .env for local development. Never commit .env.
# Use a dedicated test wallet with no funds.
PRIVATE_KEY=YOUR_TEST_WALLET_PRIVATE_KEY
CHAIN_ID=31337
CONTRACT_ADDRESS=YOUR_DEPLOYED_EXECUTOR_ADDRESS
TARGET_ADDRESS=YOUR_INTENDED_TARGET_ADDRESS
INTENT_NONCE=0

# Optional settings
INTENT_VALUE=0
INTENT_DATA=0x
INTENT_TTL=300
# Mainnet signing is blocked unless deliberately enabled:
# ALLOW_MAINNET_SIGNING=1
